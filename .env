NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=http://localhost:8082/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dblrqxs6d
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
NEXT_PUBLIC_BACKEND_URL=http://localhost:8082
NEXT_PUBLIC_GRPC_URL=http://localhost:8081
NEXT_PUBLIC_DOCUMENTATION_URL=https://vsay-docs-site.vercel.app
NEXT_PUBLIC_COMUNITY_URL=https://community-ui-swart.vercel.app
NEXT_PUBLIC_APP_VERSION=1.2.0
NEXT_PUBLIC_TUNNEL_URL=http://localhost:8082
METRICS_AUTH_URL=http://localhost:8082        # internal URL of vsay-auth
METRICS_BACKEND_URL=http://localhost:8080

# Switch off self-service signup in this PORTAL.
#
# With it on, /signup redirects to the login page and the "Create account"
# link disappears — so nobody can create an organisation (a tenant) from the
# interface. Tenants are then made by whoever runs the installation.
#
# This closes the portal's door, NOT the API's. /auth/signup is still there
# and still works, which is the point: scripts and provisioning keep going.
# If signup must be refused outright, that has to be done in vsay-auth.
#
# Unset or empty means signup stays open, so an existing deployment upgrading
# into this change behaves exactly as it did before.
NEXT_PUBLIC_DISABLE_SIGNUP=true
